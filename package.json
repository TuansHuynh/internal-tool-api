{
  "name": "internal-api-client",
  "version": "1.3.12",
  "description": "Cross-platform Internal API Client with Stress Testing & SQLite persistence",
  "private": true,
  "scripts": {
    "dev": "wails dev",
    "build:updater": "go build -ldflags=\"-s -w\" -o internal/updater/bin/updater.exe ./cmd/updater/",
    "build": "npm run build:updater && wails build",
    "build:full": "npm run build:updater && wails build",
    "sync": "node scripts/sync-version.js",
    "bump:patch": "node scripts/bump-version.js patch",
    "bump:minor": "node scripts/bump-version.js minor",
    "bump:major": "node scripts/bump-version.js major",
    "bump": "node scripts/bump-version.js",
    "release": "node scripts/bump-version.js patch --build"
  },
  "keywords": [
    "wails",
    "api-client",
    "stress-test",
    "postman-alternative"
  ],
  "author": "TuansHuynh <nkoc.nho.17.04@gmail.com>",
  "license": "MIT"
}
